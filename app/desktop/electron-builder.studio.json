{
  "appId": "org.pravrudhi.studio",
  "productName": "Pravrudhi Studio",
  "files": [
    "main.js",
    "preload.js",
    "lib/**",
    "renderer/**",
    "package.json"
  ],
  "linux": {
    "target": "AppImage",
    "category": "Development",
    "icon": "renderer/icon.png"
  },
  "mac": {
    "target": "dmg",
    "identity": null,
    "icon": "renderer/icon.png",
    "category": "public.app-category.developer-tools"
  },
  "win": {
    "target": [
      "nsis",
      "zip"
    ],
    "icon": "renderer/icon.png"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true
  },
  "directories": {
    "output": "dist/studio"
  },
  "extraResources": [
    {
      "from": "editions/studio.json",
      "to": "edition.json"
    }
  ]
}
