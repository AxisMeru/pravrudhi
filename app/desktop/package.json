{
  "name": "pravrudhi-desktop",
  "version": "0.4.0",
  "private": true,
  "description": "The native desktop shell for an installed Pravrudhi engine",
  "author": "Pravrudhi",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --config electron-builder.product.json",
    "dist:linux": "electron-builder --linux --config electron-builder.product.json",
    "test": "node --test test/",
    "smoke": "node smoke.js",
    "smoke:dist": "node smoke-dist.js",
    "dist:mac": "electron-builder --mac --config electron-builder.product.json",
    "dist:win": "electron-builder --win --config electron-builder.product.json",
    "dist:studio": "electron-builder --config electron-builder.studio.json",
    "dist:studio:linux": "electron-builder --linux --config electron-builder.studio.json"
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.0.0"
  }
}
