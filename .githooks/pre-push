#!/usr/bin/env bash
# Client-side guard: refuses any `git push` whose REMOTE ref is refs/heads/main from a normal command-line push.
# Merges to main go through a pull request. Same hook as prabhasa-nyaya's.
#
# WHAT THIS DOES NOT STOP. It is a client-side hook: it runs on the pusher's own machine, using
# whatever `core.hooksPath` that checkout has configured. A push via the GitHub API/web UI, a push
# from a checkout that never ran `make init`, or `git push --no-verify` all bypass it entirely --
# hence layers 2 (the server-side main-push-has-pr alarm) and 3 (the daily audit) existing at all.
# A real merge (GitHub's own "Merge pull request" button, or the API `PUT /pulls/{n}/merge`) is
# NOT a `git push` from any local checkout, so this hook never sees it and never blocks a merge.
set -euo pipefail

REFS="$(cat)"
while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ "$remote_ref" == "refs/heads/main" ]]; then
    echo "pre-push: REFUSED -- direct push to main." >&2
    echo "  Merges to main go through a pull request (GitHub's own merge button or the API)," >&2
    echo "  never a direct 'git push'. If this push is itself a legitimate merge commit already" >&2
    echo "  produced by a PR merge (rare: re-pushing a ref after a rebase of an already-merged" >&2
    echo "  branch), do it through the GitHub UI/API instead of from this checkout." >&2
    exit 1
  fi
done <<< "$REFS"

# Layer: identity at push time (#287). commit-msg checks only the commit being made; cherry-pick, rebase, am and
# `git -c`/env tricks bypass it. Every NEW commit in a pushed ref (reachable from the pushed sha, on no remote-tracking
# branch yet), on ANY branch, must have author AND committer listed in allowed-identities, unless its full sha is
# listed in identity-sha-allowlist (known legacy offenders). Fails closed: an unreadable range or missing list refuses.
HOOKDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIST="$HOOKDIR/allowed-identities"
SHALIST="$HOOKDIR/identity-sha-allowlist"
ZERO=0000000000000000000000000000000000000000
# Each list is read ONCE into a variable and matched with a here-string, never `grep -v | grep -q`: under `set -o pipefail` a
# `grep -q` that exits on an early match SIGPIPEs the writer once the list is larger than a pipe buffer (~64 KB), the pipeline
# returns 141, and a listed sha or identity silently stops being honoured.
SHAS="$(grep -v '^[[:space:]]*#' "$SHALIST" 2>/dev/null || true)"
bad=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ "$local_sha" == "$ZERO" ]] && continue
  [[ -f "$LIST" ]] || { echo "pre-push: $LIST is missing; refusing" >&2; exit 1; }
  IDENTS="$(grep -v '^[[:space:]]*#' "$LIST" | sed 's/[[:space:]]*$//')"
  log="$(git log --format='%H%x09%an <%ae>%x09%cn <%ce>' "$local_sha" --not --remotes 2>/dev/null)" || {
    echo "pre-push: cannot read the commits being pushed for $local_ref; refusing" >&2; exit 1; }
  while IFS=$'\t' read -r sha author committer; do
    [[ -z "$sha" ]] && continue
    grep -qxF -- "$sha" <<< "$SHAS" && continue
    for who in "$author" "$committer"; do
      if ! grep -qxF -- "$who" <<< "$IDENTS"; then
        echo "pre-push: REFUSED -- commit ${sha:0:10} has identity '$who', not in .githooks/allowed-identities (author '$author', committer '$committer')." >&2
        bad=1
      fi
    done
  done <<< "$log"
done <<< "$REFS"
if [[ $bad -ne 0 ]]; then
  echo "  Fix: set a listed identity and rewrite the commits that are NOT yet pushed anywhere (git rebase --exec 'git commit --amend --reset-author --no-edit'); published history is never rewritten. Legacy commits: add the full sha to .githooks/identity-sha-allowlist with a reason." >&2
  exit 1
fi

exit 0
