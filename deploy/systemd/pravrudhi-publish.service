# Refresh what the operator can see. Export the snapshot, build, verify the pages carry content, commit on a new
# publish/snapshot-* branch, scan it for personal data, push the branch and open a PR. `main` is protected (a PR and
# the required `guards` check), so nothing is pushed to it and the PR is never merged here: a person merges it after
# a decoded personal-data scan. One snapshot PR at a time. Needs a disposable clone (@PUBLISH_ROOT@) that is reset to
# origin/main on every run. Refuses at the first failing step rather than publishing a page that answers 200 and
# renders an error.
[Unit]
Description=Pravrudhi publish
After=network-online.target

# The export REQUIRES the private-name list (a path outside every repository, and its pinned sha256). Both come from an environment file kept
# beside the other local settings, never committed: PRAVRUDHI_DEMO_PRIVATE_NAMES=<path> and PRAVRUDHI_DEMO_PRIVATE_NAMES_SHA256=<sha256>.
# Without them the export step fails (naming the missing variables, never a name) and nothing is published.

[Service]
Type=oneshot
EnvironmentFile=-%h/.config/pravrudhi/demo_export.env
WorkingDirectory=@ROOT@
ExecStart=@ROOT@/.venv/bin/python -m pravrudhi publish --root @ROOT@ --write-root @PUBLISH_ROOT@ --json
TimeoutStartSec=2400
