# ~/.config/systemd/user/pravrudhi-e2e-nightly.service — nightly signed-in check of both hosted doors.
# install: cp deploy/e2e-nightly/pravrudhi-e2e-nightly.{service,timer} ~/.config/systemd/user/ && systemctl --user daemon-reload && systemctl --user enable --now pravrudhi-e2e-nightly.timer
[Unit]
Description=Pravrudhi nightly: signed-in e2e check of both hosted doors, against a real non-admin account
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=%h/.config/pravrudhi/e2e.env
ExecStart=%h/projects/pravrudhi/deploy/e2e-nightly/run_e2e_nightly.sh
TimeoutStartSec=1800
