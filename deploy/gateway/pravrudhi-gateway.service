# ~/.config/systemd/user/pravrudhi-gateway.service — both hosted engines reachable through their Workers.
# install: cp deploy/gateway/pravrudhi-gateway.service ~/.config/systemd/user/ && systemctl --user enable --now pravrudhi-gateway
[Unit]
Description=Pravrudhi gateway: engine containers behind cloudflared tunnels, registered in Cloudflare KV
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/projects/pravrudhi/deploy/gateway/run_gateway.sh
Restart=always
RestartSec=20
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Hold the Studio KV write across restarts (run_gateway.sh STUDIO_HOLD_KV): while Studio is kept offline behind its Worker
# (engine_url_studio blank), uncomment this OR set STUDIO_HOLD_KV=1 in ~/.config/pravrudhi/gateway.env. The flag is read on
# every start; if it lives in neither place, a restart registers the Studio tunnel again. Remove it to bring Studio back.
#Environment=STUDIO_HOLD_KV=1

[Install]
WantedBy=default.target
